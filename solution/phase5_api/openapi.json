{
  "openapi": "3.1.0",
  "info": {
    "title": "Hospital Operations & Revenue Risk Intelligence API",
    "description": "Prediction services for the Hospital Operations & Revenue Risk Intelligence Platform.\n\n* **POST `/predict/claim-outcome`** - Model B. Flags a claim for pre-submission\n  review when calibrated `P(Rejected)` clears the Phase 4 operating threshold.\n* **POST `/predict/visit-risk`** - Model A. A calibrated **base-rate monitor**\n  (no signal above the class prior on the pilot year); use it to track risk-mix\n  drift, not to prioritise an individual visit.\n* **GET `/model-info`** - versions, feature counts, thresholds, domains.\n* **GET `/health`** - model + database readiness.\n\nEvery response carries `model_version` / `feature_spec_version`; every prediction\nis appended to `capstone_solution.prediction_log`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/model-info": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Model Info",
        "operationId": "model_info_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict/claim-outcome": {
      "post": {
        "tags": [
          "predict"
        ],
        "summary": "Model B - pre-submission claim outcome",
        "operationId": "predict_claim_outcome_predict_claim_outcome_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimOutcomeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimOutcomeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/predict/visit-risk": {
      "post": {
        "tags": [
          "predict"
        ],
        "summary": "Model A - visit risk (base-rate monitor)",
        "operationId": "predict_visit_risk_predict_visit_risk_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisitRiskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitRiskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
